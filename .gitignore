# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# Native OS binaries (C++/Rust compiled cores via FFI)
lib/modules/native/*.dll
lib/modules/native/*.so
lib/modules/native/*.dylib

# Platform build outputs
windows/flutter/ephemeral/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/

# Logs and temporary files
logs/
*.log
pending_operation.json
assets/temp/

# Local IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated files
*.g.dart
*.freezed.dart

# Personal config - uncomment if config contains secrets/tokens/keys
config.ini
config.json

# Portable runtime symlink history; never publish local paths or targets
assets/data/

# Local test exports and conversation/runtime scratch files
ja_symlinks_import_test.json
conversation_detail.md
Backed
Restored

# Build/packaging output (regenerated by dart-build-pro, not source)
dist/
dist_pack/
*.lnk

# Local safety backup of the live symlink DB, made by build.bat before each rebuild
backup/

# License that should absolutely not be committed
license.key

# Claude Code / Antigravity project-local tooling (skills, agent config, runtime locks)
.claude/
.agents/
